<Project>
  <PropertyGroup>
    <MicrosoftTestingPlatformVersion>2.0.1</MicrosoftTestingPlatformVersion>
    <MicrosoftTestSDKVersion>18.0.0</MicrosoftTestSDKVersion>
    <XunitV3Version>3.1.0</XunitV3Version>
    <XunitV3RunnerVersion>3.1.5</XunitV3RunnerVersion>
  </PropertyGroup>
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />
  <ItemGroup>

    <PackageVersion Include="xunit.v3" Version="$(XunitV3Version)" />
    <PackageVersion Include="xunit.v3.assert" Version="$(XunitV3Version)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(XunitV3RunnerVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0-rc.2.25502.107" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftTestSDKVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Testing" Version="9.6.0-preview.1.25310.2" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="AwesomeAssertions" Version="9.3.0" />

  </ItemGroup>
</Project>
