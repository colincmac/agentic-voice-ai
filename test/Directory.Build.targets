<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Stop complaining about enabling /doc for tests -->
    <NoWarn>$(NoWarn);EXTEXP0014;EXTEXP0016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio"/>
  </ItemGroup>

  
  <ItemGroup>
    <Using Include="System.Net" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Xunit" />

  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)/xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)\AI.TestingFramework\AI.TestingFramework.csproj" Condition="'$(MSBuildProjectName)' != 'AI.TestingFramework'" />
  </ItemGroup>
</Project>
