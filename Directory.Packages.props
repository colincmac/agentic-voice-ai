<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AspNetCoreVersion>10.0.4</AspNetCoreVersion>
    <MicrosoftAIEvaluationVersion>10.1.0</MicrosoftAIEvaluationVersion>

    <MicrosoftExtensionsVersion>10.1.0</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsVersionAI>10.3.0</MicrosoftExtensionsVersionAI>

    <MicrosoftAgentsFrameworkVersion>1.0.0-preview.251204.1</MicrosoftAgentsFrameworkVersion>
    <AspireVersion>13.1.0</AspireVersion>
    <DaprVersion>1.16.1</DaprVersion>
    
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="A2A" Version="0.3.3-preview" />
    <PackageVersion Include="A2A.AspNetCore" Version="0.3.3-preview" />
    <!-- Aspire -->

    <PackageVersion Include="Aspire.Azure.AI.OpenAI" Version="13.1.0-preview.1.25616.3" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.AIFoundry" Version="13.1.0-preview.1.25616.3" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppConfiguration" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.ApplicationInsights" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.CognitiveServices" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.Redis" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.SignalR" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.OpenAI" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Python" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Microsoft.Azure.Cosmos" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.StackExchange.Redis.OutputCaching" Version="$(AspireVersion)" />

    
    <PackageVersion Include="Azure.AI.Agents.Persistent" Version="1.2.0-beta.8" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.8.0-beta.1" />
    <PackageVersion Include="Azure.AI.VoiceLive" Version="1.1.0-beta.3" />
    <PackageVersion Include="Azure.Communication.CallAutomation" Version="1.6.0-beta.1" />
    <PackageVersion Include="Azure.Communication.Common" Version="1.4.0" />
    <PackageVersion Include="Azure.Communication.Identity" Version="1.4.0-beta.1" />
    
    <PackageVersion Include="Azure.Identity" Version="1.18.0-beta.2" />
    <PackageVersion Include="Azure.Messaging.EventGrid" Version="5.0.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.27.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.5.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.4.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Certificates" Version="4.8.0-beta.1" />
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.8.0-beta.1" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Azure.Dapr" Version="13.0.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Azure.Dapr.Redis" Version="13.0.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Dapr" Version="13.0.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Dapr.AzureRedis" Version="13.0.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.JavaScript.Extensions" Version=" 13.0.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.OpenTelemetryCollector" Version="13.0.1-beta.468" />
    <PackageVersion Include="CommunityToolkit.Aspire.OllamaSharp" Version="13.0.0" />
    <PackageVersion Include="Dapr.Actors.AspNetCore" Version="1.16.1" />
    <PackageVersion Include="Dapr.AspNetCore" Version="1.16.1" />
    <PackageVersion Include="Dapr.Client" Version="1.16.1" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageVersion Include="Grpc.HealthCheck" Version="2.76.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.76.0" />
    <!-- Agent SDKs -->
    <PackageVersion Include="Microsoft.Agents.Authentication.Msal" Version="1.3.102-beta" />
    <PackageVersion Include="Microsoft.Agents.Builder.Dialogs" Version="1.3.102-beta" />
    <PackageVersion Include="Microsoft.Agents.Extensions.Teams" Version="1.3.102-beta" />
    <PackageVersion Include="Microsoft.Agents.Extensions.Teams.AI" Version="1.3.102-beta" />
    <PackageVersion Include="Microsoft.Agents.Hosting.AspNetCore" Version="1.3.102-beta" />

    <!-- Agent Framework SDKs -->

    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="$(MicrosoftAgentsFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="$(MicrosoftAgentsFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="$(MicrosoftAgentsFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.AzureAI" Version="$(MicrosoftAgentsFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting" Version="$(MicrosoftAgentsFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.A2A" Version="$(MicrosoftAgentsFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.AGUI" Version="$(MicrosoftAgentsFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.A2A" Version="$(MicrosoftAgentsFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" Version="$(MicrosoftAgentsFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.AGUI" Version="$(MicrosoftAgentsFrameworkVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="$(MicrosoftAgentsFrameworkVersion)" />


    <!-- Base & Microsoft.Extensions.* -->

    <PackageVersion Include="Microsoft.AspNetCore.Authentication" Version="2.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Abstractions" Version="2.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Server" Version="$(AspNetCoreVersion)" />

    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.Azure.AppConfiguration.AspNetCore" Version="8.5.0-preview" />
    <PackageVersion Include="Microsoft.Azure.StackExchangeRedis" Version="3.3.0" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="$(MicrosoftExtensionsVersionAI)" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="$(MicrosoftExtensionsVersionAI)" />
    <PackageVersion Include="Microsoft.Extensions.AI.AzureAIInference" Version="10.0.0-preview.1.25559.3" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="$(MicrosoftExtensionsVersionAI)" />
    
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation" Version="$(MicrosoftAIEvaluationVersion)" />
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="$(MicrosoftAIEvaluationVersion)" />
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation.Reporting" Version="$(MicrosoftAIEvaluationVersion)" />
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation.NLP" Version="10.1.0-preview.1.25608.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation.Safety" Version="10.1.0-preview.1.25608.1" />
    
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Azure" Version="1.13.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.4" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Telemetry.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.FeatureManagement.AspNetCore" Version="4.3.0" />

    <!-- Authentication and Authorization -->
    <PackageVersion Include="Microsoft.Graph" Version="5.85.0" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.78.0" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Identity.Web.AgentIdentities" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Identity.Web.DownstreamApi" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Identity.Web.GraphServiceClient" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Identity.Web.MicrosoftGraph" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Identity.Web.TokenCache" Version="4.0.1" />

    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="ModelContextProtocol" Version="0.3.0-preview.2" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="0.3.0-preview.2" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="0.3.0-preview.2" />
    <PackageVersion Include="NAudio" Version="2.2.1" />
    <PackageVersion Include="OpenAI" Version="2.9.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.14.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.14.0" />
    <PackageVersion Include="StackExchange.Redis" Version="2.10.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="System.Linq.Async" Version="6.0.3" />
    <PackageVersion Include="System.Memory.Data" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="System.Net.ServerSentEvents" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="System.Reactive" Version="6.1.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>
</Project>
