# FamilyAI AG-UI Backend URL
# This is the URL of the Showcase.Agent.FamilyAI ASP.NET Core application
# Default: http://localhost:8000/
FAMILY_AI_AGUI_URL=http://localhost:8000/

# FamilyAI REST API URL for direct API calls (content upload, listing)
# Default: http://localhost:8000
NEXT_PUBLIC_FAMILY_AI_API_URL=http://localhost:8000

# Azure Communication Services connection string (for video calling)
# Get this from the Azure Portal > Communication Services > Keys
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=

# Voice Agent API URL (for operator dashboard)
NEXT_PUBLIC_VOICE_AGENT_API_URL=http://localhost:5000
